# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text diff=python

# Documentation
*.md text diff=markdown
*.txt text
*.rst text

# Configuration files
*.json text
*.yaml text
*.yml text
*.toml text
*.ini text
*.cfg text

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Docker
Dockerfile text
.dockerignore text

# Git
.gitignore text
.gitattributes text

# Makefiles
Makefile text
makefile text

# License
LICENSE text

# Logs (should be ignored but just in case)
*.log text

# Database files (should be ignored but just in case)
*.db binary
*.sqlite binary
*.sqlite3 binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary

# Executables
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Audio/Video
*.mp3 binary
*.mp4 binary
*.avi binary
*.mov binary
*.wav binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary